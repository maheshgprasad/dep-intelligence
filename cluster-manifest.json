{
  "schema_version": 1,
  "services": [
    {
      "id": "uocp-api-gateway",
      "repository": "https://github.com/hvrcorp/uocp-api-gateway",
      "language": "python",
      "frameworks": [
        "fastapi"
      ],
      "http": {
        "origins": [
          "http://gateway:8000",
          "http://localhost:8000"
        ],
        "host_aliases": [
          "gateway",
          "uocp-api-gateway"
        ],
        "base_path": ""
      },
      "contracts": {
        "http": [
          {
            "method": "POST",
            "path": "/send/message",
            "handler": "common/runtime.py::send"
          },
          {
            "method": "POST",
            "path": "/send/{channel}",
            "handler": "common/runtime.py::send"
          }
        ]
      },
      "expected": [
        {
          "kind": "http",
          "consumer": "uocp-api-gateway",
          "provider": "uocp-auth-service",
          "method": "POST",
          "path": "/v1/validate",
          "symbol": "common/runtime.py::send"
        },
        {
          "kind": "http",
          "consumer": "uocp-api-gateway",
          "provider": "uocp-tenant-service",
          "method": "GET",
          "path": "/v1/tenants/{tenant_id}",
          "symbol": "common/runtime.py::send"
        },
        {
          "kind": "http",
          "consumer": "uocp-api-gateway",
          "provider": "uocp-routing-service",
          "method": "POST",
          "path": "/v1/route",
          "symbol": "common/runtime.py::send"
        }
      ]
    },
