    {
      "id": "uocp-api-gateway",
      "repository": "https://github.com/hvrcorp/uocp-api-gateway",
      "language": "python",
      "frameworks": [
        "fastapi"
      ],
      "http": {
        "origins": [
          "http://gateway:8000",
          "http://localhost:8000"
        ],
        "host_aliases": [
          "gateway",
          "uocp-api-gateway"
        ],
        "base_path": ""
      },
      "contracts": {
        "http": [
          {
            "method": "POST",
            "path": "/send/message",
            "handler": "common/runtime.py::send"
          },
          {
            "method": "POST",
            "path": "/send/sms",
            "handler": "common/runtime.py::send"
          },
          {
            "method": "POST",
            "path": "/send/email",
            "handler": "common/runtime.py::send"
          },
          {
            "method": "POST",
            "path": "/send/whatsapp",
            "handler": "common/runtime.py::send"
          },
          {
            "method": "POST",
            "path": "/send/voice",
            "handler": "common/runtime.py::send"
          },
          {
            "method": "POST",
            "path": "/send/webrtc",
            "handler": "common/runtime.py::send"
          },
          {
            "method": "POST",
            "path": "/send/{channel}",
            "handler": "common/runtime.py::send"
          },
          {
            "method": "GET",
            "path": "/v1/messages/{correlation_id}",
            "handler": "common/runtime.py::message_status"
          }
        ]
      },
      "expected": [
        {
          "kind": "http",
          "consumer": "uocp-api-gateway",
          "provider": "uocp-auth-service",
          "method": "POST",
          "path": "/v1/validate",
          "symbol": "common/runtime.py::validate_key"
        },
        {
          "kind": "http",
          "consumer": "uocp-api-gateway",
          "provider": "uocp-tenant-service",
          "method": "GET",
          "path": "/v1/tenants/demo-tenant",
          "symbol": "common/runtime.py::load_tenant"
        },
        {
          "kind": "http",
          "consumer": "uocp-api-gateway",
          "provider": "uocp-tenant-service",
          "method": "GET",
          "path": "/v1/tenants/demo-tenant/limits",
          "symbol": "common/runtime.py::load_limits"
        },
        {
          "kind": "http",
          "consumer": "uocp-api-gateway",
          "provider": "uocp-auth-service",
          "method": "POST",
          "path": "/v1/rbac/check",
          "symbol": "common/runtime.py::check_role"
        },
        {
          "kind": "http",
          "consumer": "uocp-api-gateway",
          "provider": "uocp-routing-service",
          "method": "POST",
          "path": "/v1/route",
          "symbol": "common/runtime.py::ask_route"
        }
